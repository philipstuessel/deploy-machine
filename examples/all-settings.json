{
  "name": "example",
  "vars": {
    "host": "203.0.113.10",
    "user": "deploy",
    "port": "22",
    "ssh_key_file": "~/.ssh/deploy_key",
    "known_hosts_file": "~/.ssh/known_hosts",
    "ssh_path": "{{current_link}}",
    "source": "dist",
    "deploy_path": "/srv/app",
    "strategy": "release",
    "keep_releases": "5",
    "releases_dir": "{{deploy_path}}/releases",
    "release_path": "{{releases_dir}}/{{release}}",
    "current_link": "{{deploy_path}}/current",
    "healthcheck_url": "https://example.com",
    "rollback_on_failure": "true",
    "deps_install": "auto",
    "dry_run": "false"
  },
  "steps": [
    {
      "name": "Test",
      "type": "run",
      "on": "local",
      "cmd": "npm test"
    },
    {
      "name": "Build",
      "type": "run",
      "on": "local",
      "cmd": "npm run build"
    },
    {
      "name": "Upload release",
      "type": "upload",
      "from": "{{source}}/",
      "to": "{{release_path}}/",
      "delete": true,
      "exclude": [
        ".DS_Store",
        "*.map"
      ]
    },
    {
      "name": "Fix permissions",
      "type": "run",
      "on": "remote",
      "cmd": "chmod -R a+rX {{release_path}}"
    },
    {
      "name": "Activate release",
      "type": "symlink",
      "target": "{{release_path}}",
      "link": "{{current_link}}"
    },
    {
      "name": "Health check",
      "type": "healthcheck",
      "url": "{{healthcheck_url}}",
      "expect_status": 200,
      "retries": 5,
      "delay": 3
    },
    {
      "name": "Remove old releases",
      "type": "cleanup",
      "keep": "{{keep_releases}}",
      "allow_failure": true
    }
  ]
}
