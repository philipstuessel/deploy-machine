{
  "vars": {
    "host": "203.0.113.10",
    "user": "deploy",
    "ssh_key_file": "~/.ssh/deploy_key",
    "deploy_path": "/srv/app",
    "source": "dist",
    "keep_releases": "5"
  },
  "steps": [
    {
      "name": "Upload release",
      "type": "upload",
      "from": "{{source}}/",
      "to": "{{release_path}}/",
      "delete": true,
      "exclude": [
        "uploads"
      ]
    },
    {
      "name": "Create shared folder",
      "type": "run",
      "on": "remote",
      "cmd": "mkdir -p {{deploy_path}}/shared/uploads"
    },
    {
      "name": "Link uploads into the release",
      "type": "symlink",
      "target": "{{deploy_path}}/shared/uploads",
      "link": "{{release_path}}/uploads"
    },
    {
      "name": "Activate release",
      "type": "symlink",
      "target": "{{release_path}}",
      "link": "{{current_link}}"
    },
    {
      "name": "Remove old releases",
      "type": "cleanup",
      "keep": "{{keep_releases}}",
      "allow_failure": true
    }
  ]
}
